# Copy this file to .env and fill in real values (never commit .env itself).

# GoPlus Security's token_security endpoint is free and does not require a
# key for basic/low-volume use. If we start hitting rate limits, GoPlus docs
# mention an app_key/app_secret pair for an access token with higher limits.
# VERIFY in the official GoPlus docs whether/when this is needed before use.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Which chain to query by default (1 = Ethereum mainnet).
DEFAULT_CHAIN_ID=1

# Etherscan V2 API key - free from https://etherscan.io/myapikey
# Adds transaction history, token transfers and contract creation date.
# Optional: without it the scanner still works, just without those panels.
# NOTE: the FREE plan covers Ethereum, Polygon and Arbitrum. BSC and Base
# need a paid plan, and token *holdings* is a Pro-only endpoint.
ETHERSCAN_API_KEY=

# Chainabuse API key - free from chainabuse.com:
#   profile (top right) > View Profile > Settings > API key
# Adds community scam reports (phishing, rug pulls...) that GoPlus and the
# blocklists miss. WARNING: the free plan allows only 10 lookups PER MONTH.
# The app only calls it when other sources are unsure, and caches every
# answer permanently in ml-service/data/, so each address costs at most once.
CHAINABUSE_API_KEY=
