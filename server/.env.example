# Copy this file to .env and fill in real values (never commit .env itself).

# Port this Express server listens on.
PORT=4000

# Base URL of the Python ml-service (see ../ml-service/README.md).
ML_SERVICE_URL=http://localhost:8000

# MongoDB connection string. Use a local MongoDB, Docker, or a free
# MongoDB Atlas cluster - any of these work, just point this at it.
MONGODB_URI=mongodb://localhost:27017/scam-token-scorer
